{
  "expo": {
    "name": "Faunapedia",
    "slug": "faunapedia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "faunapedia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.faunapedia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.faunapedia"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#07090B"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Faunapedia utilise votre position pour afficher les espèces observées autour de vous."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07090B",
    "extra": {
      "shareUrl": "https://github.com/Aesmyrel/Faunapedia"
    }
  }
}
